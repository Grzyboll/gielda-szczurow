rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ogłoszenia (oferuję / szukam) dodawane wyłącznie przez bota Discord
    // (Cloud Function discordInteractions, Admin SDK — omija te reguły).
    // Strona tylko czyta.
    match /listings/{listingId} {
      allow read: if true;
      allow write: if false;
    }

    // Ranking punktowy (za dodane ogłoszenia i za pomoc w znalezieniu
    // tatuażu) — też wyłącznie zapisywany przez discordInteractions.
    match /rankings/{userId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
